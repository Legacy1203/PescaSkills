{
  "manifest_version": 3,
  "name": "PescaSkills",
  "version": "1.0.1",
  "background": {
    "service_worker": "notification-worker.js"
  },
  "description": "Atalhos para comandos de pesca do Twish no chat da Twitch, com temas ClÃƒÂ¡ssico e Skills.",
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "twish-status-core.js",
        "smart-selectors-core.js",
        "fishing-sound.js",
        "alert-state.js",
        "notification-settings.js",
        "content.js",
        "pesca-theme.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://twish.com.br/*"
      ],
      "js": [
        "twish-status-core.js",
        "smart-selectors-core.js",
        "twish-status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/pescaskills-logo.png",
        "assets/pescaskills-background.png",
        "assets/pescaskills-logo-classic.png",
        "assets/pescaskills-background-classic.png",
        "assets/fishing-ready.mp3",
        "assets/event-ready.mp3"
      ],
      "matches": [
        "https://www.twitch.tv/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "notifications"
  ]
}

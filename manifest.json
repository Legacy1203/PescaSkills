{
  "manifest_version": 3,
  "name": "PescaSkills",
  "version": "1.0.1",
  "description": "Atalhos para comandos de pesca do Twish no chat da Twitch, com temas Clássico e Skills.",
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*"
      ],
      "js": [
        "twish-status-core.js",
        "smart-selectors-core.js",
        "content.js",
        "pesca-theme.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://twish.com.br/*"
      ],
      "js": [
        "twish-status-core.js",
        "smart-selectors-core.js",
        "twish-status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}
